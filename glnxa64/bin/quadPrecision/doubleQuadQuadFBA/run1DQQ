#!/bin/bash
# run1DQQ

# This is a typical Unix script for running a program such as MINOS.
# It should be marked executable (via chmod +x run1DQQ).
# Note that file names of the form fort.* may be machine-dependent.
#
# 27 Jan 2016: run1DQQ bash script derived from csh script
#              to be more standard.

 if [ $# -lt 1 ]
 then
      echo ' '
      echo '  Script for running DQQ on an MPS file in ../MPS'
      echo './run1DQQ pilot4'
      echo 'runs the DQQ procedure on pilot4.'
      echo 'Step D  cold starts minos with pilot4.mps, lpD.spc'
      echo '    and saves fort.9, fort.10 in results/pilot4.outD,  results/pilot4.basisD'
      echo ' '
      echo 'Step Q1 warm starts qminos from fort.10 with lpQ1.spc'
      echo '    and saves fort.9, fort.11 in results/pilot4.outQ1, results/pilot4.basisQ1'
      echo ' '
      echo 'Step Q2 warm starts qminos from fort.11 with lpQ2.spc'
      echo '    and saves fort.9, fort.12 in results/pilot4.outQ2, results/pilot4.basisQ2'
      echo ' '
      echo 'Each step adds a line to fort.60'
      echo 'Eventually:  cp fort.60 results/infeasDQQ.txt  for plotDQQ.m'
      echo ' '
      exit
 fi

 PROB=$1
 MPS=./MPS

 if [ ! -e $MPS/$PROB.mps ]
 then
    echo "Error: MPS/$PROB.mps  not found"
    exit 1
 fi

 \cp -p $MPS/$PROB.mps  fort.10	

 if [ ! -e results ]
 then
    mkdir results
 fi

#=================
# Run step D
#=================
 \cp -fp lpD.spc   fort.4
 ./solveD
 \cp -fp fort.9    results/$PROB.outD
 \cp -fp fort.11   results/$PROB.basisD  >& /dev/null

#=================
# Run step Q1
#=================
 \cp -fp lpQ1.spc  fort.4
 ./solveQ
 \cp -fp fort.9    results/$PROB.outQ1
 \cp -fp fort.12   results/$PROB.basisQ1  >& /dev/null

#=================
# Run step Q2
#=================
 \cp -fp lpQ2.spc  fort.4
 ./solveQ
 \cp -fp fort.9    results/$PROB.outQ2
 \cp -fp fort.13   results/$PROB.basisQ2  >& /dev/null

#=================
# Info
#=================
 echo " "
 echo "Lines in fort.60:"
 grep -i $PROB fort.60

 echo " "
 echo "Created following files:"
 ls -l results/$PROB.*
 echo "End of ./run1DQQ $PROB"
 echo " "

#=================
# Compatibility with solveCobraLP.m (Ronan 2026)
#=================
 \cp -fp fort.81 $PROB.sol       >& /dev/null


